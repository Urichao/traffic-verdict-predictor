# 複製成 .env 後填入（.env 已列入 .gitignore，不會被提交）

# 司法院資料開放平台：瀏覽器登入後，從開發者工具 > Application > Cookies
# 複製 "Authorization" 的值（含 Bearer 前綴，有效期約一年）
JUDICIAL_TOKEN=

# 司法院裁判書開放 API 帳密（每日 00:00–06:00 可用）
JUDICIAL_USER=
JUDICIAL_PASSWORD=

# 語言模型（預設 Ollama；若改用 llama-server 則設為 http://127.0.0.1:8080/v1/chat/completions）
LLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
LLAMA_MODEL=gemma4:e4b
